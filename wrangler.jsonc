{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whatsapp-fitness-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "workflows": [
    {
      "name": "fitness-ingestion",
      "binding": "FITNESS_INGESTION",
      "class_name": "FitnessIngestionWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FITNESS_AGENT",
        "class_name": "FitnessAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FitnessAgent"],
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whatsapp-fitness-agent",
      "database_id": "e4dec91e-0fb9-4e4f-a2bb-e4db040f5356",
      "migrations_dir": "drizzle",
    },
  ],
}
