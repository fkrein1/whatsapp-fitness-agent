{
  "name": "whatsapp-fitness-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user WhatsApp fitness log on Cloudflare Workers, D1, and GPT-5.6 Luna",
  "keywords": [
    "ai-agent",
    "cloudflare-d1",
    "cloudflare-workers",
    "drizzle-orm",
    "fitness",
    "hono",
    "whatsapp"
  ],
  "homepage": "https://github.com/fkrein1/whatsapp-fitness-agent#readme",
  "bugs": {
    "url": "https://github.com/fkrein1/whatsapp-fitness-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fkrein1/whatsapp-fitness-agent.git"
  },
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply whatsapp-fitness-agent --local",
    "db:migrate:remote": "wrangler d1 migrations apply whatsapp-fitness-agent --remote",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "wrangler dev",
    "test": "vitest run --maxWorkers=50%",
    "test:watch": "vitest --maxWorkers=50%",
    "typecheck": "wrangler types --check && tsc --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.10.2",
    "@cloudflare/shell": "^0.4.3",
    "@cloudflare/think": "^0.16.0",
    "agents": "^0.21.0",
    "ai": "^7.0.73",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@11.22.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@mongodb-js/zstd",
      "core-js-pure",
      "node-liblzma"
    ]
  }
}
